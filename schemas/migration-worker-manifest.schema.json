{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/migration-worker-manifest.schema.json",
  "title": "Qyrenith Migration Worker Manifest",
  "type": "object",
  "required": ["schema", "worker_id", "worker_version", "implementation_digest", "protocol_version", "scopes", "capabilities", "permissions", "limits", "manifest_digest"],
  "properties": {
    "schema": {"const": 1},
    "worker_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "worker_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "implementation_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "protocol_version": {"const": 1},
    "scopes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": ["kind", "source", "target"],
        "properties": {
          "kind": {"enum": ["VERSION_UPGRADE", "LOADER_CONVERSION", "FRAMEWORK_CHANGE", "PLATFORM_MIGRATION", "TOOLCHAIN_CHANGE", "DEPENDENCY_MIGRATION", "PROJECT_PROFILE_CHANGE"]},
          "source": {"$ref": "migration-knowledge.schema.json#/$defs/identity"},
          "target": {"$ref": "migration-knowledge.schema.json#/$defs/identity"}
        },
        "additionalProperties": false
      }
    },
    "capabilities": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["READ_PROJECT", "WRITE_PROJECT", "EXECUTE_PROCESS", "NETWORK", "INSTALL_DEPENDENCIES", "GIT_WRITE", "PUBLISH_ARTIFACT"]}
    },
    "limits": {
      "type": "object",
      "required": ["timeout_seconds", "max_input_bytes", "max_output_bytes", "max_changed_files"],
      "properties": {
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "max_input_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "max_output_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
        "max_changed_files": {"type": "integer", "minimum": 1, "maximum": 100000}
      },
      "additionalProperties": false
    },
    "manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
