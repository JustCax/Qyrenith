{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qyrenith.dev/schemas/qdas-failure-hypothesis.schema.json",
  "title": "Qyrenith QDAS Failure Hypothesis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hypothesis_id",
    "event_id",
    "failure_category",
    "rule_id",
    "statement",
    "supporting_evidence",
    "contradicting_evidence",
    "confidence",
    "confidence_rationale",
    "missing_evidence",
    "state"
  ],
  "properties": {
    "hypothesis_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "failure_category": {
      "enum": [
        "BUILD_FAILURE",
        "TEST_FAILURE",
        "STATIC_ANALYSIS_FAILURE",
        "RUNTIME_FAILURE",
        "INFRASTRUCTURE_FAILURE",
        "TIMEOUT",
        "RESOURCE_LIMIT",
        "ANALYZER_FAILURE",
        "UNSUPPORTED_STATE",
        "UNKNOWN_FAILURE"
      ]
    },
    "rule_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "statement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "supporting_evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "contradicting_evidence": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "confidence": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW"
      ]
    },
    "confidence_rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "missing_evidence": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "state": {
      "const": "UNCONFIRMED"
    }
  },
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "event_id",
        "stream",
        "line_number",
        "line_digest",
        "excerpt"
      ],
      "properties": {
        "observation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "event_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "stream": {
          "enum": [
            "stdout",
            "stderr"
          ]
        },
        "line_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200000
        },
        "line_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "excerpt": {
          "type": "string",
          "maxLength": 320
        }
      }
    }
  }
}
