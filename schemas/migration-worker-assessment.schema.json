{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/migration-worker-assessment.schema.json",
  "title": "Qyrenith Migration Route Worker Assessment",
  "type": "object",
  "required": [
    "schema",
    "route_plan_digest",
    "evaluated_at",
    "status",
    "evaluations",
    "reason"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "route_plan_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "status": {
      "enum": [
        "ROUTE_NOT_PLANNED",
        "NO_WORK_REQUIRED",
        "UNKNOWN",
        "BLOCKED",
        "QUALIFIED"
      ]
    },
    "evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "transition",
          "resolution"
        ],
        "properties": {
          "transition": {
            "$ref": "migration-transition.schema.json"
          },
          "resolution": {
            "$ref": "#/$defs/workerResolution"
          }
        },
        "additionalProperties": false
      },
      "minItems": 0
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    }
  },
  "additionalProperties": false,
  "$defs": {
    "workerResolution": {
      "type": "object",
      "required": [
        "status",
        "worker_id",
        "worker_version",
        "manifest_digest",
        "qualification_id",
        "qualification_digest",
        "permissions",
        "limits",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "BLOCKED",
            "NOT_SELECTED",
            "NOT_REGISTERED",
            "INCOMPATIBLE",
            "UNQUALIFIED",
            "STALE",
            "QUALIFIED"
          ]
        },
        "worker_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "worker_version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "manifest_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "qualification_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "qualification_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "READ_PROJECT",
              "WRITE_PROJECT",
              "EXECUTE_PROCESS",
              "NETWORK",
              "INSTALL_DEPENDENCIES",
              "GIT_WRITE",
              "PUBLISH_ARTIFACT"
            ]
          }
        },
        "limits": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "timeout_seconds",
            "max_input_bytes",
            "max_output_bytes",
            "max_changed_files"
          ],
          "properties": {
            "timeout_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            },
            "max_input_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 67108864
            },
            "max_output_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16777216
            },
            "max_changed_files": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            }
          },
          "additionalProperties": false
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "NOT_SELECTED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "worker_id": {
                "type": "null"
              },
              "worker_version": {
                "type": "null"
              },
              "manifest_digest": {
                "type": "null"
              },
              "qualification_id": {
                "type": "null"
              },
              "qualification_digest": {
                "type": "null"
              },
              "permissions": {
                "maxItems": 0
              },
              "limits": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "NOT_REGISTERED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "worker_id",
              "worker_version"
            ],
            "properties": {
              "worker_id": {
                "type": "string",
                "minLength": 1
              },
              "worker_version": {
                "type": "string",
                "minLength": 1
              },
              "manifest_digest": {
                "type": "null"
              },
              "qualification_id": {
                "type": "null"
              },
              "qualification_digest": {
                "type": "null"
              },
              "permissions": {
                "maxItems": 0
              },
              "limits": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "BLOCKED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "manifest_digest": {
                "type": "null"
              },
              "qualification_id": {
                "type": "null"
              },
              "qualification_digest": {
                "type": "null"
              },
              "permissions": {
                "maxItems": 0
              },
              "limits": {
                "type": "null"
              }
            },
            "oneOf": [
              {
                "required": [
                  "worker_id",
                  "worker_version"
                ],
                "properties": {
                  "worker_id": {
                    "type": "null"
                  },
                  "worker_version": {
                    "type": "null"
                  }
                }
              },
              {
                "required": [
                  "worker_id",
                  "worker_version"
                ],
                "properties": {
                  "worker_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "worker_version": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "INCOMPATIBLE"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "worker_id",
              "worker_version",
              "manifest_digest"
            ],
            "properties": {
              "worker_id": {
                "type": "string",
                "minLength": 1
              },
              "worker_version": {
                "type": "string",
                "minLength": 1
              },
              "manifest_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "qualification_id": {
                "type": "null"
              },
              "qualification_digest": {
                "type": "null"
              },
              "limits": {
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "UNQUALIFIED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "worker_id",
              "worker_version",
              "manifest_digest"
            ],
            "properties": {
              "worker_id": {
                "type": "string",
                "minLength": 1
              },
              "worker_version": {
                "type": "string",
                "minLength": 1
              },
              "manifest_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "qualification_id": {
                "type": "null"
              },
              "qualification_digest": {
                "type": "null"
              },
              "limits": {
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "STALE"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "worker_id",
              "worker_version",
              "manifest_digest",
              "qualification_id",
              "qualification_digest"
            ],
            "properties": {
              "worker_id": {
                "type": "string",
                "minLength": 1
              },
              "worker_version": {
                "type": "string",
                "minLength": 1
              },
              "manifest_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "qualification_id": {
                "type": "string",
                "minLength": 1
              },
              "qualification_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "limits": {
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "QUALIFIED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "worker_id",
              "worker_version",
              "manifest_digest",
              "qualification_id",
              "qualification_digest"
            ],
            "properties": {
              "worker_id": {
                "type": "string",
                "minLength": 1
              },
              "worker_version": {
                "type": "string",
                "minLength": 1
              },
              "manifest_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "qualification_id": {
                "type": "string",
                "minLength": 1
              },
              "qualification_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "limits": {
                "type": "object"
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ROUTE_NOT_PLANNED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "evaluations": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "NO_WORK_REQUIRED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "evaluations": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "QUALIFIED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "evaluations": {
            "minItems": 1,
            "items": {
              "properties": {
                "resolution": {
                  "properties": {
                    "status": {
                      "const": "QUALIFIED"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "UNKNOWN"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "evaluations": {
            "minItems": 1,
            "contains": {
              "properties": {
                "resolution": {
                  "properties": {
                    "status": {
                      "enum": [
                        "NOT_SELECTED",
                        "NOT_REGISTERED",
                        "UNQUALIFIED",
                        "STALE"
                      ]
                    }
                  }
                }
              }
            },
            "not": {
              "contains": {
                "properties": {
                  "resolution": {
                    "properties": {
                      "status": {
                        "enum": [
                          "BLOCKED",
                          "INCOMPATIBLE"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "BLOCKED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "evaluations": {
            "minItems": 1,
            "contains": {
              "properties": {
                "resolution": {
                  "properties": {
                    "status": {
                      "enum": [
                        "BLOCKED",
                        "INCOMPATIBLE"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
