{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/migration-knowledge.schema.json",
  "title": "Qyrenith Migration Knowledge Claim",
  "type": "object",
  "required": [
    "schema",
    "claim_id",
    "subject",
    "statement",
    "assertion",
    "source",
    "target",
    "status",
    "evidence",
    "verified_by",
    "verified_at",
    "valid_until",
    "verified_with",
    "verifier_version",
    "verifier_digest"
  ],
  "properties": {
    "schema": {
      "const": 2
    },
    "claim_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "statement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "source": {
      "$ref": "#/$defs/identity"
    },
    "target": {
      "$ref": "#/$defs/identity"
    },
    "status": {
      "enum": [
        "OBSERVED",
        "INFERRED",
        "UNKNOWN",
        "VERIFIED",
        "CONFLICTED",
        "STALE"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "maxItems": 10000
    },
    "verified_by": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "verified_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "maxLength": 64
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "maxLength": 64
    },
    "assertion": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 2048
    },
    "verified_with": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 256
    },
    "verifier_version": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128
    },
    "verifier_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "required": [
        "domain",
        "product",
        "product_version",
        "platform",
        "loader",
        "loader_version",
        "framework",
        "framework_version",
        "language",
        "toolchain",
        "dependency_fingerprint",
        "profile"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "product": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "product_version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "platform": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "loader": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "loader_version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "framework": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "framework_version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "language": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "toolchain": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "dependency_fingerprint": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "profile": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "evidence_id",
        "origin",
        "locator",
        "observed_at",
        "digest"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "origin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "VERIFIED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "assertion",
          "verified_by",
          "verified_at",
          "evidence",
          "verified_with",
          "verifier_version",
          "verifier_digest",
          "valid_until"
        ],
        "properties": {
          "assertion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "verified_by": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "verified_at": {
            "type": "string",
            "format": "date-time"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "properties": {
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              }
            }
          },
          "valid_until": {
            "type": "string",
            "format": "date-time",
            "maxLength": 64
          },
          "verified_with": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "verifier_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "verifier_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "valid_until": {
            "type": "string"
          }
        },
        "required": [
          "valid_until"
        ]
      },
      "then": {
        "properties": {
          "verified_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  ]
}
