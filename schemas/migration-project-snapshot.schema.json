{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qyrenith.dev/schemas/migration-project-snapshot.schema.json",
  "title": "Qyrenith Project Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "entries",
    "excluded_paths",
    "limits",
    "captured_at",
    "snapshot_digest"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "maxItems": 1000000,
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "excluded_paths": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "limits": {
      "$ref": "#/$defs/limits"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "snapshot_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_entries",
        "max_file_bytes",
        "max_total_bytes",
        "max_depth",
        "max_path_length"
      ],
      "properties": {
        "max_entries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "max_file_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483648
        },
        "max_total_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 17179869184
        },
        "max_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "max_path_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "mode",
        "size",
        "content_digest",
        "link_target"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "kind": {
          "enum": [
            "file",
            "directory",
            "symlink"
          ]
        },
        "mode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 511
        },
        "size": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "content_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "link_target": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "file"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "size": {
                "type": "integer"
              },
              "content_digest": {
                "type": "string"
              },
              "link_target": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "directory"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "size": {
                "type": "null"
              },
              "content_digest": {
                "type": "null"
              },
              "link_target": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "symlink"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "size": {
                "type": "null"
              },
              "content_digest": {
                "type": "null"
              },
              "link_target": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
