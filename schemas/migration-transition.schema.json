{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/migration-transition.schema.json",
  "title": "Qyrenith Migration Transition",
  "type": "object",
  "required": [
    "schema",
    "transition_id",
    "source",
    "target",
    "kind",
    "knowledge_claim_ids",
    "worker_id",
    "enabled",
    "worker_version",
    "required_capabilities"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "transition_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source": {
      "$ref": "migration-knowledge.schema.json#/$defs/identity"
    },
    "target": {
      "$ref": "migration-knowledge.schema.json#/$defs/identity"
    },
    "kind": {
      "enum": [
        "VERSION_UPGRADE",
        "LOADER_CONVERSION",
        "FRAMEWORK_CHANGE",
        "PLATFORM_MIGRATION",
        "TOOLCHAIN_CHANGE",
        "DEPENDENCY_MIGRATION",
        "PROJECT_PROFILE_CHANGE"
      ]
    },
    "knowledge_claim_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "maxItems": 1000
    },
    "worker_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "required_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "maxItems": 1000
    },
    "enabled": {
      "type": "boolean"
    },
    "worker_version": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "worker_id": {
            "type": "string"
          }
        },
        "required": [
          "worker_id"
        ]
      },
      "then": {
        "properties": {
          "worker_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "worker_id": {
            "const": null
          }
        },
        "required": [
          "worker_id"
        ]
      },
      "then": {
        "properties": {
          "worker_version": {
            "const": null
          }
        }
      }
    }
  ]
}
